# Allow wcnss service (cnss-daemon) to create/read/write calibration files in /data/vendor/wifi
allow vendor_wcnss_service vendor_wifi_vendor_data_file:dir create_dir_perms;
allow vendor_wcnss_service vendor_wifi_vendor_data_file:file create_file_perms;

# nv_mac が persist のBTアドレスを読む
allow vendor_wcnss_service vendor_persist_bluetooth_file:dir r_dir_perms;
allow vendor_wcnss_service vendor_persist_bluetooth_file:file r_file_perms;
