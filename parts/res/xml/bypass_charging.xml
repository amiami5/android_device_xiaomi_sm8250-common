<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/bypass_charging_title">

    <!--
        android:persistent="false" is the XML-level guard against the
        AndroidX preference library storing the checked state in
        SharedPreferences.  BypassChargingFragment also calls
        setPersistent(false) in code as a belt-and-suspenders measure.

        The summary is overwritten at runtime by BypassChargingFragment
        via updateSummary() to reflect the live kernel state, but we
        provide the "off" string as the XML default so the screen never
        flashes blank text before onResume() fires.
    -->
    <com.android.settingslib.widget.MainSwitchPreference
        android:key="bypass_charging_enable"
        android:title="@string/bypass_charging_title"
        android:summary="@string/bypass_charging_status_off"
        android:persistent="false"
        android:defaultValue="false" />

    <!--
        Footer that explains what bypass charging does and warns the user
        that battery percentage will not increase while the feature is on.
        The feature is also automatically off after every reboot.
    -->
    <com.android.settingslib.widget.FooterPreference
        android:key="bypass_charging_footer"
        android:title="@string/bypass_charging_footer"
        android:selectable="false" />

</PreferenceScreen>
